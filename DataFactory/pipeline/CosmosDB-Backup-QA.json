{
	"name": "CosmosDB-Backup-QA",
	"properties": {
		"activities": [
			{
				"name": "ForEach_ald",
				"type": "ForEach",
				"dependsOn": [],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.cw_items",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Copy_ald",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [
								{
									"name": "Source",
									"value": "@{item().source.collectionName}"
								},
								{
									"name": "Destination",
									"value": "cosmos-backup//@{item().destination.fileName}"
								}
							],
							"typeProperties": {
								"source": {
									"type": "CosmosDbSqlApiSource",
									"preferredRegions": []
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobStorageWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings",
										"filePattern": "setOfObjects"
									}
								},
								"enableStaging": false,
								"validateDataConsistency": false
							},
							"inputs": [
								{
									"referenceName": "SourceCosmos",
									"type": "DatasetReference",
									"parameters": {
										"cw_collectionName": "@item().source.collectionName"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DestinationBlob",
									"type": "DatasetReference",
									"parameters": {
										"cw_fileName": "@item().destination.fileName"
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"cw_items": {
				"type": "Array",
				"defaultValue": [
					{
						"source": {
							"collectionName": "AssessmentDeliverable"
						},
						"destination": {
							"fileName": "AssessmentDeliverable.json"
						}
					},
					{
						"source": {
							"collectionName": "BluePrint"
						},
						"destination": {
							"fileName": "BluePrint.json"
						}
					},
					{
						"source": {
							"collectionName": "Certification"
						},
						"destination": {
							"fileName": "Certification.json"
						}
					},
					{
						"source": {
							"collectionName": "Exam"
						},
						"destination": {
							"fileName": "Exam.json"
						}
					},
					{
						"source": {
							"collectionName": "IdCounter"
						},
						"destination": {
							"fileName": "IdCounter.json"
						}
					},
					{
						"source": {
							"collectionName": "Job"
						},
						"destination": {
							"fileName": "Job.json"
						}
					},
					{
						"source": {
							"collectionName": "JobTaskAnalysis"
						},
						"destination": {
							"fileName": "JobTaskAnalysis.json"
						}
					},
					{
						"source": {
							"collectionName": "Organization"
						},
						"destination": {
							"fileName": "Organization.json"
						}
					},
					{
						"source": {
							"collectionName": "Person"
						},
						"destination": {
							"fileName": "Person.json"
						}
					},
					{
						"source": {
							"collectionName": "PersonSession"
						},
						"destination": {
							"fileName": "PersonSession.json"
						}
					},
					{
						"source": {
							"collectionName": "StaticData"
						},
						"destination": {
							"fileName": "StaticData.json"
						}
					}
				]
			}
		},
		"annotations": [],
		"lastPublishTime": "2020-08-20T16:11:28Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}