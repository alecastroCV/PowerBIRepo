{
	"name": "DestinationBlob",
	"properties": {
		"linkedServiceName": {
			"referenceName": "DestinationCosmosDB",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"cw_fileName": {
				"type": "String"
			}
		},
		"annotations": [],
		"type": "Json",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": {
					"value": "@dataset().cw_fileName",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd/HH')",
					"type": "Expression"
				},
				"container": "cosmos-backup"
			}
		},
		"schema": {}
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}